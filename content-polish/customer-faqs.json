" aria-controls=\"main-nav-content\" aria-expanded=\"false\" aria-label=\"Toggle navigation\">\n            <span class=\"navbar-toggler-icon\"></span>\n        </button>\n        <div class=\"collapse navbar-collapse\" id=\"main-nav-content\">\n            <ul class=\"navbar-nav me-auto mb-2 mb-lg-0\">\n                <li class=\"nav-item\"><a class=\"nav-link\" href=\"/\">Home</a></li>\n                <li class=\"nav-item\"><a class=\"nav-link\" href=\"/who-we-are\">About Us</a></li>\n                <li class=\"nav-item dropdown\">\n                    <a class=\"nav-link dropdown-toggle\" href=\"#\" role=\"button\" data-bs-toggle=\"dropdown\">Services</a>\n                    <ul class=\"dropdown-menu\">\n                        <li><a class=\"dropdown-item\" href=\"/services/airport-pick-drops\">Airport Pick &amp; Drops</a></li>\n                        <li><a class=\"dropdown-item\" href=\"/services/inter-city\">Inter-City (City to City)</a></li>\n                        <li><a class=\"dropdown-item\" href=\"/services/local-transfers\">Local Transfers</a></li>\n                        <li><a class=\"dropdown-item\" href=\"/services/ziyarat-tours\">Ziyarat/Tours</a></li>\n                    </ul>\n                </li>\n                <li class=\"nav-item dropdown\">\n                    <a class=\"nav-link dropdown-toggle\" href=\"/fleet\" role=\"button\" data-bs-toggle=\"dropdown\">Vehicles</a>\n                    <ul class=\"dropdown-menu\">\n                        <li><a class=\"dropdown-item fw-bold\" href=\"/fleet\" style=\"color: var(--clr-accent) !important;\"><i class=\"fas fa-th-large me-2\"></i> All Vehicles (Fleet Gallery)</a></li>\n                        <li><hr class=\"dropdown-divider\" style=\"border-color: var(--clr-border);\"></li>\n                        <li><a class=\"dropdown-item\" href=\"/fleet/toyota-camry\">1. Toyota Camry</a></li>\n                        <li><a class=\"dropdown-item\" href=\"/fleet/hyundai-sonata\">2. Hyundai Sonata</a></li>\n                        <li><a class=\"dropdown-item\" href=\"/fleet/hyundai-staria\">3. Hyundai Staria</a></li>\n                        <li><a class=\"dropdown-item\" href=\"/fleet/gmc-xl-yukon\">4. GMC XL Yukon</a></li>\n                        <li><a class=\"dropdown-item\" href=\"/fleet/hiace-grand-cabin\">5. Hiace Grand Cabin</a></li>\n                        <li><a class=\"dropdown-item\" href=\"/fleet/coaster\">6. Coaster / Minibuses</a></li>\n                    </ul>\n                </li>\n                <li class=\"nav-item\">\n                    <a class=\"nav-link\" href=\"/ziyarat-guide\">Ziyarat Guide</a>\n                </li>\n            </ul>\n            <ul class=\"navbar-nav ms-auto align-items-lg-center gap-2\">\n                <li class=\"nav-item\">\n                    <a data-wa=\"general\" href=\"https://wa.me/966565476113?text=Assalamu%20Alaikum%2C%20I%20would%20like%20to%20ask%20about%20your%20Umrah%20transport%20services.%0APage%3A%20https%3A%2F%2Falharmainumrahtransport.com%2Fcustomer-faqs\" target=\"_blank\" class=\"btn btn-success\" style=\"background-color: var(--clr-success); border-color: var(--clr-success); color: var(--clr-on-success); display: inline-flex; align-items: center; gap: 6px; font-weight: 600; padding: 0.45rem 0.9rem; font-size: var(--text-sm); border-radius: 7px;\">\n                        <i class=\"fab fa-whatsapp\" style=\"font-size: var(--text-base);\"></i> WhatsApp\n                    </a>\n                </li>\n            </ul>\n        </div>\n    </div>\n</nav>\r\n<body class=\"static-page-body\">\r\n\r\n    <section class=\"page-hero\">\r\n        <div class=\"hero-background\" style=\"background-image: url('/img/all-drivers-sitting-together.jpeg');\"></div>\r\n        <div class=\"hero-overlay\" style=\"background: rgba(var(--clr-bg-rgb), 0.6);\"></div>\r\n        <div class=\"container\">\r\n            <div class=\"hero-content text-center\">\r\n                <h1 class=\"display-4 text-white\">Customer Terms &amp; FAQs</h1>\r\n                <p class=\"lead text-white-50\">Important information and answers to common questions.</p>\r\n            </div>\r\n        </div>\r\n    </section>\r\n\r\n    <section class=\"content-section py-5\">\r\n        <div class=\"container\">\r\n            <div class=\"row justify-content-center\">\r\n                <div class=\"col-lg-10\">\r\n                    <h2 class=\"section-title-static text-center mb-5\">Frequently Asked Questions</h2>\r\n                    <div class=\"accordion\" id=\"faqAccordion\">\r\n\r\n                        <!-- Booking Questions -->\r\n                        <h4 class=\"mt-4\">Booking & Reservations</h4>\r\n                        <div class=\"accordion-item\"><h2 class=\"accordion-header\"><button class=\"accordion-button\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#collapseOne\">How do I book a ride?</button></h2><div id=\"collapseOne\" class=\"accordion-collapse collapse show\" data-bs-parent=\"#faqAccordion\"><div class=\"accordion-body\">You can easily book a ride through the booking form on our homepage or the \"Book Now\" page. Simply select your service, enter the required details like pickup/drop-off locations and dates, choose your vehicle, and complete the booking process.</div></div></div>\r\n                        <div class=\"accordion-item\"><h2 class=\"accordion-header\"><button class=\"accordion-button collapsed\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#collapseTwo\">Can I make a booking for someone else?</button></h2><div id=\"collapseTwo\" class=\"accordion-collapse collapse\" data-bs-parent=\"#faqAccordion\"><div class=\"accordion-body\">Yes, absolutely. When making the booking, please enter the passenger's full name and contact number in the designated fields. All confirmations and communications will be sent to the email address you provide during booking.</div></div></div>\r\n                        <div class=\"accordion-item\"><h2 class=\"accordion-header\"><button class=\"accordion-button collapsed\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#collapseThree\">How far in advance should I book?</button></h2><div id=\"collapseThree\" class=\"accordion-collapse collapse\" data-bs-parent=\"#faqAccordion\"><div class=\"accordion-body\">We recommend booking at least 24 hours in advance to ensure vehicle availability, especially during peak seasons like Ramadan and Hajj. However, we do our best to accommodate last-minute bookings based on availability.</div></div></div>\r\n\r\n                        <!-- Payment Questions -->\r\n                        <h4 class=\"mt-5\">Payments & Pricing</h4>\r\n                        <div class=\"accordion-item\"><h2 class=\"accordion-header\"><button class=\"accordion-button collapsed\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#collapseFour\">Are your prices fixed?</button></h2><div id=\"collapseFour\" class=\"accordion-collapse collapse\" data-bs-parent=\"#faqAccordion\"><div class=\"accordion-body\">Yes, the price you see at the time of booking is the final price you pay. It includes all taxes, tolls, and fees. There are no hidden charges.</div></div></div>\r\n                        <div class=\"accordion-item\"><h2 class=\"accordion-header\"><button class=\"accordion-button collapsed\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#collapseFive\">What payment methods do you accept?</button></h2><div id=\"collapseFive\" class=\"accordion-collapse collapse\" data-bs-parent=\"#faqAccordion\"><div class=\"accordion-body\">We accept payments via Bank Transfer and Cash on Pickup. For bank transfers, you will be required to upload proof of payment to confirm your booking.</div></div></div>\r\n\r\n                        <!-- Service Questions -->\r\n                        <h4 class=\"mt-5\">Service & Vehicles</h4>\r\n                        <div class=\"accordion-item\"><h2 class=\"accordion-header\"><button class=\"accordion-button collapsed\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#collapseSix\">What happens if my flight is delayed?</button></h2><div id=\"collapseSix\" class=\"accordion-collapse collapse\" data-bs-parent=\"#faqAccordion\"><div class=\"accordion-body\">For all airport pickups, we monitor your flight status in real-time. Our driver will be there to meet you at the new arrival time, at no extra cost. We offer a complimentary waiting time of 90 minutes after your flight has landed.</div></div></div>\r\n                        <div class=\"accordion-item\"><h2 class=\"accordion-header\"><button class=\"accordion-button collapsed\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#collapseSeven\">Where will I meet my driver at the airport?</button></h2><div id=\"collapseSeven\" class=\"accordion-collapse collapse\" data-bs-parent=\"#faqAccordion\"><div class=\"accordion-body\">Your driver will be waiting in the arrivals hall after you exit customs, holding a sign with your name on it. For detailed instructions, please see our <a href=\"/airport-pickup-guidelines\">Airport Pickup Guidelines</a> page.</div></div></div>\r\n                        <div class=\"accordion-item\"><h2 class=\"accordion-header\"><button class=\"accordion-button collapsed\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#collapseEight\">Can I request a child seat?</button></h2><div id=\"collapseEight\" class=\"accordion-collapse collapse\" data-bs-parent=\"#faqAccordion\"><div class=\"accordion-body\">Yes, child seats can be requested as an 'addon' service during the booking process, subject to availability. Please specify the type of seat needed (infant, toddler) if possible.</div></div></div>\r\n\r\n                        <!-- Policy Questions -->\r\n                        <h4 class=\"mt-5\">Policies</h4>\r\n                        <div class=\"accordion-item\"><h2 class=\"accordion-header\"><button class=\"accordion-button collapsed\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#collapseNine\">What is your cancellation policy?</button></h2><div id=\"collapseNine\" class=\"accordion-collapse collapse\" data-bs-parent=\"#faqAccordion\"><div class=\"accordion-body\">Cancellations made more than 24 hours before the scheduled pickup time are fully refundable. Cancellations made within 24 hours may be subject to a cancellation fee. Please see our full <a href=\"/refund-policy\">Refund Policy</a> for more details.</div></div></div>\r\n\r\n                    </div>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </section>\r\n\r\n<!-- Main Footer Section -->\r\n    <footer class=\"main-site-footer\">\r\n        <div class=\"container\">\r\n            <div class=\"row gy-4\">\r\n                <!-- Company Info Column -->\r\n                <div class=\"col-lg-3 col-md-6\">\r\n                    <a class=\"d-flex align-items-center mb-3\" href=\"/\"\r\n                        style=\"gap: 12px; text-decoration: none;\">\r\n                        <img width=\"240\" height=\"240\" src=\"/img/LOGO.png\" alt=\"AL HARMAIN UMRAH TRANSPORT Logo\"\r\n                            style=\"height: 60px; width: auto; max-height: 60px; object-fit: contain; display: inline-block; vertical-align: middle; \" loading=\"lazy\" decoding=\"async\">\r\n                        <span\r\n                            style=\"font-weight: 700; color: var(--clr-accent); font-size: var(--text-xl); letter-spacing: 0.5px; font-family: 'Poppins', sans-serif;\">Al\r\n                            Armain Umrah Transport</span>\r\n                    </a>\r\n                    <p class=\"footer-text\">\r\n                        Get reliable Sedan cars, SUVs, luxury cars, coasters and buses for your Hajj and Umrah journey.\r\n                        Travel in brand-new luxury vehicles with ultimate comfort.\r\n                    </p>\r\n                </di