on-title text-center mb-5\"></h2>\n            <div class=\"row g-4\">\n                <!-- 1. 3 in 1 Kiswah Factory/Makkah Museum / Sulah Hudaibiyah -->\n                <div class=\"col-sm-6 col-lg-4 d-flex align-items-stretch\">\n                    <div class=\"service-card h-100\">\n                        <img width=\"600\" height=\"315\" src=\"/uploads/services/1752562083_WhatsApp Image 2025-07-15 at 11.46.50 AM.jpeg\" alt=\"3 in 1 Kiswah Factory/Makkah Museum / Sulah Hudaibiyah\" class=\"service-card-image\" loading=\"lazy\" decoding=\"async\">\n                        <div class=\"service-card-content\">\n                            <div class=\"service-card-category\">Ziyarat/Tours</div>\n                            <h4>3 in 1 Kiswah Factory/Makkah Museum / Sulah Hudaibiyah</h4>\n                            <p>Exclusive 3-in-1 tour: Kiswa Factory, Makkah Museum, and Sulah Hudaibiyah, a cultural and historical immersion.</p>\n                            <div class=\"mt-auto\">\n                                <a class=\"primary-button d-block text-center\" href=\"/services/3-in-1-kiswa-factory-makkah-museum-sulah-hudaibiyah\">View Details & Book</a>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n\n                <!-- 2. Makkah Ziyarat -->\n                <div class=\"col-sm-6 col-lg-4 d-flex align-items-stretch\">\n                    <div class=\"service-card h-100\">\n                        <img width=\"900\" height=\"551\" src=\"/uploads/services/makkah_ziyarat_arafat.jpg\" alt=\"Makkah Ziyarat\" class=\"service-card-image\" loading=\"lazy\" decoding=\"async\">\n                        <div class=\"service-card-content\">\n                            <div class=\"service-card-category\">Ziyarat/Tours</div>\n                            <h4>Makkah Ziyarat</h4>\n                            <p>Guided spiritual tour of sacred sites across Makkah Mukarramah: Mount Arafat, Mina, Muzdalifah, Cave Hira (Jabal al-Nour), Cave Thawr, and Jabal al-Rahmah.</p>\n                            <div class=\"mt-auto\">\n                                <a class=\"primary-button d-block text-center\" href=\"/services/makkah-ziyarat\">View Details & Book</a>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n\n                <!-- 3. Medina Ziyarat -->\n                <div class=\"col-sm-6 col-lg-4 d-flex align-items-stretch\">\n                    <div class=\"service-card h-100\">\n                        <img width=\"626\" height=\"420\" src=\"/uploads/services/madinah_ziyarat_collage.jpg\" alt=\"Medina Ziyarat\" class=\"service-card-image\" loading=\"lazy\" decoding=\"async\">\n                        <div class=\"service-card-content\">\n                            <div class=\"service-card-category\">Ziyarat/Tours</div>\n                            <h4>Medina Ziyarat</h4>\n                            <p>Peaceful guided visit to holy landmarks in Al-Madinah Al-Munawwarah: Masjid Quba, Mount Uhud, Masjid al-Qiblatayn, Seven Mosques, and Jannatul Baqi.</p>\n                            <div class=\"mt-auto\">\n                                <a class=\"primary-button d-block text-center\" href=\"/services/madinah-ziyarat\">View Details & Book</a>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n\n                <!-- 4. Makkah to Taif Ziyarat -->\n                <div class=\"col-sm-6 col-lg-4 d-flex align-items-stretch\">\n                    <div class=\"service-card h-100\">\n                        <img width=\"320\" height=\"167\" src=\"/uploads/services/makkah_taif_ziyarat.jpg\" alt=\"Makkah to Taif Ziyarat\" class=\"service-card-image\" loading=\"lazy\" decoding=\"async\">\n                        <div class=\"service-card-content\">\n                            <div class=\"service-card-category\">Ziyarat/Tours</div>\n                            <h4>Makkah to Taif Ziyarat</h4>\n                            <p>Private round-trip transfer from Makkah to Taif: Shubra Palace, Addas Garden, Masjid Abdullah Ibn Abbas, Cable Car &amp; Al-Hada mountain views.</p>\n                            <div class=\"mt-auto\">\n                                <a class=\"primary-button d-block text-center\" href=\"/services/makkah-to-taif-ziyarat-and-return\">View Details & Book</a>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n\n                <!-- 5. Medina to Badar Ziyarat -->\n                <div class=\"col-sm-6 col-lg-4 d-flex align-items-stretch\">\n                    <div class=\"service-card h-100\">\n                        <img width=\"1024\" height=\"682\" src=\"/uploads/services/medina_to_badar_ziyarat.jpg\" alt=\"Medina to Badar Ziyarat\" class=\"service-card-image\" loading=\"lazy\" decoding=\"async\">\n                        <div class=\"service-card-content\">\n                            <div class=\"service-card-category\">Ziyarat/Tours</div>\n                            <h4>Medina to Badar Ziyarat</h4>\n                            <p>Spiritual day tour from Madinah to Badar: Historic Battlefield of Badar, Shuhada-e-Badar Martyrs Graveyard, and Al-Arish Mosque in luxury vehicles.</p>\n                            <div class=\"mt-auto\">\n                                <a class=\"primary-button d-block text-center\" href=\"/services/madinah-hotel-to-makkah-hotel-via-badar-and-roha-well\">View Details & Book</a>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n\n                <!-- 6. Per Hours rates (minimum 5 hrs) -->\n                <div class=\"col-sm-6 col-lg-4 d-flex align-items-stretch\">\n                    <div class=\"service-card h-100\">\n                        <img width=\"1024\" height=\"575\" src=\"/img/per_hour_rates_van.jpg\" alt=\"Per Hours rates (minimum 5 hrs)\" class=\"service-card-image\" style=\"object-fit: cover; width: 100%; height: 220px;\" loading=\"lazy\" decoding=\"async\">\n                        <div class=\"service-card-content\">\n                            <div class=\"service-card-category\">Ziyarat/Tours</div>\n                            <h4>Per Hours rates (minimum 5 hrs)</h4>\n                            <p>Flexible hourly car rental with professional driver in Makkah and Madinah (minimum 5 hours booking).</p>\n                            <div class=\"mt-auto\">\n                                <a class=\"primary-button d-block text-center\" href=\"/services/jeddah-local-city-transfer\">View Details & Book</a>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n\n                <!-- 7. Medina Ziyarat to Wad e Jin -->\n                <div class=\"col-sm-6 col-lg-4 d-flex align-items-stretch\">\n                    <div class=\"service-card h-100\">\n                        <img width=\"1024\" height=\"682\" src=\"/uploads/services/medina_ziyarat_to_wad_e_jin.jpg\" alt=\"Medina Ziyarat to Wad e Jin\" class=\"service-card-image\" loading=\"lazy\" decoding=\"async\">\n                        <div class=\"service-card-content\">\n                            <div class=\"service-card-category\">Ziyarat/Tours</div>\n                            <h4>Medina Ziyarat to Wad e Jin</h4>\n                            <p>Extended Madinah Ziyarat tour combined with a visit to the famous Wadi-e-Jin (Wadi Al-Jinn) phenomenon.</p>\n                            <div class=\"mt-auto\">\n                                <a class=\"primary-button d-block text-center\" href=\"/services/madinah-ziyarat\">View Details & Book</a>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n\n                <!-- 8. Wad e Jin -->\n                <d