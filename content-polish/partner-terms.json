ggler\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#main-nav-content\" aria-controls=\"main-nav-content\" aria-expanded=\"false\" aria-label=\"Toggle navigation\">\n            <span class=\"navbar-toggler-icon\"></span>\n        </button>\n        <div class=\"collapse navbar-collapse\" id=\"main-nav-content\">\n            <ul class=\"navbar-nav me-auto mb-2 mb-lg-0\">\n                <li class=\"nav-item\"><a class=\"nav-link\" href=\"/\">Home</a></li>\n                <li class=\"nav-item\"><a class=\"nav-link\" href=\"/who-we-are\">About Us</a></li>\n                <li class=\"nav-item dropdown\">\n                    <a class=\"nav-link dropdown-toggle\" href=\"#\" role=\"button\" data-bs-toggle=\"dropdown\">Services</a>\n                    <ul class=\"dropdown-menu\">\n                        <li><a class=\"dropdown-item\" href=\"/services/airport-pick-drops\">Airport Pick &amp; Drops</a></li>\n                        <li><a class=\"dropdown-item\" href=\"/services/inter-city\">Inter-City (City to City)</a></li>\n                        <li><a class=\"dropdown-item\" href=\"/services/local-transfers\">Local Transfers</a></li>\n                        <li><a class=\"dropdown-item\" href=\"/services/ziyarat-tours\">Ziyarat/Tours</a></li>\n                    </ul>\n                </li>\n                <li class=\"nav-item dropdown\">\n                    <a class=\"nav-link dropdown-toggle\" href=\"/fleet\" role=\"button\" data-bs-toggle=\"dropdown\">Vehicles</a>\n                    <ul class=\"dropdown-menu\">\n                        <li><a class=\"dropdown-item fw-bold\" href=\"/fleet\" style=\"color: var(--clr-accent) !important;\"><i class=\"fas fa-th-large me-2\"></i> All Vehicles (Fleet Gallery)</a></li>\n                        <li><hr class=\"dropdown-divider\" style=\"border-color: var(--clr-border);\"></li>\n                        <li><a class=\"dropdown-item\" href=\"/fleet/toyota-camry\">1. Toyota Camry</a></li>\n                        <li><a class=\"dropdown-item\" href=\"/fleet/hyundai-sonata\">2. Hyundai Sonata</a></li>\n                        <li><a class=\"dropdown-item\" href=\"/fleet/hyundai-staria\">3. Hyundai Staria</a></li>\n                        <li><a class=\"dropdown-item\" href=\"/fleet/gmc-xl-yukon\">4. GMC XL Yukon</a></li>\n                        <li><a class=\"dropdown-item\" href=\"/fleet/hiace-grand-cabin\">5. Hiace Grand Cabin</a></li>\n                        <li><a class=\"dropdown-item\" href=\"/fleet/coaster\">6. Coaster / Minibuses</a></li>\n                    </ul>\n                </li>\n                <li class=\"nav-item\">\n                    <a class=\"nav-link\" href=\"/ziyarat-guide\">Ziyarat Guide</a>\n                </li>\n            </ul>\n            <ul class=\"navbar-nav ms-auto align-items-lg-center gap-2\">\n                <li class=\"nav-item\">\n                    <a data-wa=\"general\" href=\"https://wa.me/966565476113?text=Assalamu%20Alaikum%2C%20I%20would%20like%20to%20ask%20about%20your%20Umrah%20transport%20services.%0APage%3A%20https%3A%2F%2Falharmainumrahtransport.com%2Fpartner-terms\" target=\"_blank\" class=\"btn btn-success\" style=\"background-color: var(--clr-success); border-color: var(--clr-success); color: var(--clr-on-success); display: inline-flex; align-items: center; gap: 6px; font-weight: 600; padding: 0.45rem 0.9rem; font-size: var(--text-sm); border-radius: 7px;\">\n                        <i class=\"fab fa-whatsapp\" style=\"font-size: var(--text-base);\"></i> WhatsApp\n                    </a>\n                </li>\n            </ul>\n        </div>\n    </div>\n</nav>\r\n<style>\r\n    /* Custom styles for the credit policy table */\r\n    .credit-policy-table {\r\n        width: 100%;\r\n        margin-top: 1.5rem;\r\n        border-collapse: separate;\r\n        border-spacing: 0;\r\n        border: 1px solid var(--color-border);\r\n        border-radius: var(--border-radius);\r\n        overflow: hidden;\r\n        font-size: var(--text-sm);\r\n    }\r\n    .credit-policy-table th, .credit-policy-table td {\r\n        padding: 1rem;\r\n        text-align: left;\r\n        vertical-align: top;\r\n        border-bottom: 1px solid var(--color-border);\r\n    }\r\n    .credit-policy-table thead th {\r\n        background-color: rgba(var(--clr-accent-rgb), 0.25);\r\n        font-weight: 600;\r\n        color: var(--color-text-heading);\r\n    }\r\n    .credit-policy-table tbody tr:last-child td {\r\n        border-bottom: none;\r\n    }\r\n    .credit-policy-table tbody tr td:first-child {\r\n        font-weight: 600;\r\n        color: var(--color-brand-primary);\r\n    }\r\n    .credit-policy-table .highlight-cell {\r\n        background-color: rgba(var(--clr-accent-rgb), 0.1);\r\n    }\r\n</style>\r\n\r\n<body class=\"static-page-body\">\r\n\r\n    <section class=\"page-hero\">\r\n        <div class=\"hero-background\" style=\"background-image: url('https://images.unsplash.com/photo-1554224154-260325c3577d?q=80&w=1939&auto=format=fit=crop');\"></div>\r\n        <div class=\"hero-overlay\"></div>\r\n        <div class=\"container\">\r\n            <div class=\"hero-content text-center\">\r\n                <h1 class=\"display-4 text-white\">Terms & Conditions for Travel Agents</h1>\r\n                <p class=\"lead text-white-50\">This agreement governs our professional partnership and mutual commitments.</p>\r\n            </div>\r\n        </div>\r\n    </section>\r\n\r\n    <section class=\"content-section py-5\">\r\n        <div class=\"container\">\r\n            <div class=\"row justify-content-center\">\r\n                <div class=\"col-lg-10 text-content\">\r\n                    <p class=\"text-secondary\"><strong>Effective Date:</strong> September 2, 2025</p>\r\n                    <p class=\"text-secondary\"><strong>Jurisdiction:</strong> Kingdom of Saudi Arabia</p>\r\n                    <p class=\"text-secondary lead my-4\">\r\n                        AL HARMAIN UMRAH TRANSPORT is committed to delivering premium transportation services for Hajj and Umrah pilgrims. These Terms & Conditions define the responsibilities, limitations, operational guidelines, and credit/payment policy for all travel agents engaged with AL HARMAIN UMRAH TRANSPORT.\r\n                    </p>\r\n                    <hr class=\"my-5\">\r\n\r\n                    <h3 class=\"mt-5\">1. General Agreement</h3>\r\n                    <ul class=\"text-secondary\">\r\n                        <li>By engaging with AL HARMAIN UMRAH TRANSPORT, the travel agent agrees to abide by these Terms & Conditions.</li>\r\n                        <li>AL HARMAIN UMRAH TRANSPORT reserves the right to amend these Terms without prior notice. Agents are advised to review updates periodically.</li>\r\n                    </ul>\r\n\r\n                    <h3 class=\"mt-5\">2. Booking Process</h3>\r\n                    <ul class=\"text-secondary\">\r\n                        <li>All bookings must be made exclusively via the designated communication channels (WhatsApp, official booking portal).</li>\r\n                        <li>Agents must ensure customer details are accurate, complete, and provided on time.</li>\r\n                        <li>Bookings are confirmed only upon: receipt of full payment (or as per approved credit agreement), and submission of the Kashaf Form (mandatory per Saudi Government regulations, to be kept with the driver), along with guest details.</li>\r\n                    </ul>\r\n\r\n                    <h3 class=\"mt-5\">3. Rates & Payment</h3>\r\n                    <ul class=\"text-secondary\">\r\n                        <li>Price lists are subject to change without prior notice due to market or operational factors.</li>\r\n                        <li>All payments must be cleared within 3 calendar days of invoice date unless otherwise agreed.</li>\r\n                    </ul>\r\n\r\n                    <h3 class=\"mt-5\">4. Agent Payment & Credit Policy</h3>\r\n                    <div class=\"table-responsive\">\r\n                        <table class=\"credit-policy-table\">\r\n                            <thead>\r\n                                <tr>\r\n                                    <th>Stage</th>\r\n                                    <th>Duration</th>\r\n                                    <th>Payment Criteria</th>\r\n                                    <th>Credit Facility</th>\r\n                                    <th>Invoicing & Due Dates</th>\r\n                                    <th>Special Notes</th>\r\n                                </tr>\r\n                            </thead>\r\n                            <tbody>\r\n                                <tr>\r\n                                    <td>Week One (New Companies)</td>\r\n                                    <td>First 7 days</td>\r\n                                    <td>Advance payment only (per trip, per package, or via E-Wallet portal).</td>\r\n                                    <td class=\"highlight-cell\">No credit</td>\r\n                                    <td>-</td>\r\n                                    <td>Credit eligibility begins only after completing Week One successfully.</td>\r\n                                </tr>\r\n                                <tr>\r\n                                    <td>Silver Stage</td>\r\n                                    <td>14 days</td>\r\n                                    <td>Airport trips: Always advance (or wallet service). Other trips/packages allowed on credit. Eligibility: 10 trips OR SR 3,000 turnover (whichever first).</td>\r\n                                    <td class=\"highlight-cell\">Credit up to SR 3,000</td>\r\n                                    <td>Invoice issued on Day 8 (for first 7 days) with 1-day due date. Second invoice issued on Day 15 (for remaining days).</td>\r\n                                    <td>Credit eligibility begins only after completing Week One successfully.</td>\r\n                                </tr>\r\n                                <tr>\r\n                                    <td>Gold Stage</td>\r\n                                    <td>14 days</td>\r\n                                    <td>No advance for airport trips (or wallet service). Trips/packages allowed on extended credit.</td>\r\n                                    <td class=\"highlight-cell\">Credit up to SR 6,000</td>\r\n                                    <td>Invoice issued on Day 15 (covering 14 days). Due date: 3 days.</td>\r\n                                    <td>All invoices must be cleared. Custom contracts available.</td>\r\n                                </tr>\r\n                                <tr>\r\n                                    <td>Premium Stage</td>\r\n                                    <td>28 days</td>\r\n                                    <td>No advance for airport trips (or wallet service). Trips/packages allowed on extended credit.</td>\r\n                                    <td class=\"highlight-cell\">Credit up to SR 15,000</td>\r\n                                    <td>Invoice issued on Day 29 (covering 28 days). Due date: 3 days.</td>\r\n                                    <td>Custom contracts and premium benefits available.</td>\r\n                                </tr>\r\n                                <tr>\r\n                                    <td>Inactivity Reset</td>\r\n                                    <td>If agent inactive for 28 consecutive days</td>\r\n                                    <td>-</td>\r\n                                    <td class=\"highlight-cell\">Credit privileges revoked</td>\r\n                                    <td>-</td>\r\n                                    <td>Agent must restart from Stage 1 (Advance Only).</td>\r\n                                </tr>\r\n                            </tbody>\r\n                        </table>\r\n                    </div>\r\n                    <h4 class=\"mt-4\">Policy Notes</h4>\r\n                     <ul class=\"text-secondary\">\r\n                        <li><strong>Verification:</strong> Company registration copy, ID of authorized paymaster, and active WhatsApp number required. AL HARMAIN UMRAH TRANSPORT may request further documents if needed.</li>\r\n                        <li><strong>Late Payments:</strong> Result in service suspension, surcharges, and loss of credit privileges.</li>\r\n                        <li><strong>Overdue Accounts:</strong> If any invoice is overdue, no further services will be rendered until all dues are cleared, in addition to legal recovery actions.</li>\r\n                        <li><strong>Fraud/Multiple Registrations:</strong> Agents creating multiple “new accounts” under different numbers to bypass rules will be blacklisted permanently, and legal recovery will be pursued.</li>\r\n                    </ul>\r\n\r\n                    <h3 class=\"mt-5\">5. Cancellations & Refunds</h3>\r\n                    <ul class=\"text-secondary\">\r\n                        <li>AL HARMAIN UMRAH TRANSPORT may cancel or refuse services at its discretion without prior notice.</li>\r\n                        <li>In case of cancellations initiated by AL HARMAIN UMRAH TRANSPORT, a refund will be processed for services not rendered (excluding cases under Section 6).</li>\r\n                        <li>Agents may cancel bookings, but cancellation fees may apply as per the prevailing price list or agreement.</li>\r\n                    </ul>\r\n\r\n                    <h3 class=\"mt-5\">6. Responsibilities of Travel Agents</h3>\r\n                    <ul class=\"text-secondary\">\r\n                        <li>Agents must communicate AL HARMAIN UMRAH TRANSPORT's customer terms, conditions, and disclaimers to their clients.</li>\r\n                        <li>Agents must promptly notify AL HARMAIN UMRAH TRANSPORT of booking changes, delays, cancellations, or special requests.</li>\r\n                    </ul>\r\n\r\n                    <h3 class=\"mt-5\">7. Disclaimers & Limitations</h3>\r\n                    <ul class=\"text-secondary\">\r\n                        <li>AL HARMAIN UMRAH TRANSPORT shall not be liable for delays, interruptions, or cancellations caused by: Force majeure events (natural disasters, pandemics, strikes, government restrictions); Traffic conditions, road closures, or unforeseen mechanical issues.</li>\r\n                        <li>AL HARMAIN UMRAH TRANSPORT shall not be liable for indirect, incidental, or consequential damages resulting from use of its services.</li>\r\n                    </ul>\r\n                    \r\n                    <h3 class=\"mt-5\">8. Refusal of Services</h3>\r\n                    <ul class=\"text-secondary\">\r\n                        <li>AL HARMAIN UMRAH TRANSPORT reserves the right to refuse service in cases including but not limited to: Non-payment or breach of agreement; Misconduct or unreasonable demands by agents or customers.</li>\r\n                        <li>Refusals will be communicated with reasons provided.</li>\r\n                    </ul>\r\n\r\n                    <h3 class=\"mt-5\">9. Communication & Customer Support</h3>\r\n                    <ul class=\"text-secondary\">\r\n                        <li>AL HARMAIN UMRAH TRANSPORT offers 24/7 customer support for bookings, inquiries, emergencies, and special instructions.</li>\r\n                        <li>All communications (bookings, complaints, feedback) must be directed to official support channels only.</li>\r\n                    </ul>\r\n\r\n                    <h3 class=\"mt-5\">10. Confidentiality & Non-Disclosure</h3>\r\n                    <ul class=\"text-secondary\">\r\n                        <li>Agents must protect the confidentiality of pricing, operational procedures, and other proprietary information shared by AL HARMAIN UMRAH TRANSPORT.</li>\r\n                    </ul>\r\n\r\n                    <h3 class=\"mt-5\">11. Governing Law & Dispute Resolution</h3>\r\n                    <ul class=\"text-secondary\">\r\n                        <li>These Terms are governed by the laws of the Kingdom of Saudi Arabia.</li>\r\n                        <li>Disputes must first be raised in writing for amicable resolution.</li>\r\n                        <li>If unresolved, disputes will be referred to competent courts in Saudi Arabia.</li>\r\n                    </ul>\r\n\r\n                    <h3 class=\"mt-5\">12. Fraud, Default & Legal Action</h3>\r\n                    <ul class=\"text-secondary\">\r\n                        <li>Fraud, deliberate non-payment, or misconduct will result in legal complaints in the agent's country of registration, blacklisting under Saudi laws, and notification to industry partners and authorities.</li>\r\n                        <li>All legal and recovery expenses will be borne by the defaulting agent/company.</li>\r\n                    </ul>\r\n\r\n                    <h3 class=\"mt-5\">13. Amendments to Terms</h3>\r\n                    <ul class=\"text-secondary\">\r\n                        <li>AL HARMAIN UMRAH TRANSPORT may revise these Terms at any time without notice.</li>\r\n                        <li>Continued use of services constitutes acceptance of updated Terms.</li>\r\n                    </ul>\r\n                    \r\n                    <h3 class=\"mt-5\">14. General Conditions</h3>\r\n                    <ul class=\"text-secondary\">\r\n                        <li>Credit is a professional courtesy and not a right.</li>\r\n                        <li>No interest is charged, but deadlines are strictly enforced.</li>\r\n                        <li>AL HARMAIN UMRAH TRANSPORT may require deposits or guarantees for high-volume bookings.</li>\r\n                        <li>Management's decisions regarding credit, cancellations, or services are final and binding.</li>\r\n                    </ul>\r\n\r\n                    <hr class=\"my-5\">\r\n                    <div class=\"acknowledgment-box p-4 rounded\" style=\"background-color: var(--color-surface-solid); border-left: 5px solid var(--color-brand-primary);\">\r\n                        <h4 class=\"text-warning\">Acknowledgment</h4>\r\n                        <p class=\"text-secondary\">\r\n                            By accepting the price list and engaging in business with AL HARMAIN UMRAH TRANSPORT, the travel agent acknowledges that they have read, understood, and agreed to these Terms & Conditions, including the staged credit/payment system, inactivity reset rule, and overdue service suspension policy.\r\n                        </p>\r\n                    </div>\r\n\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </section>\r\n\r\n<!-- Main Footer Section -->\r\n    <footer class=\"main-site-footer\">\r\n        <div class=\"container\">\r\n            <div class=\"row gy-4\">\r\n                <!-- Company Info Column -->\r\n                <div class=\"col-lg-3 col-md-6\">\r\n                    <a class=\"d-flex align-items-center mb-3\" href=\"/\"\r\n                        style=\"gap: 12px; text-decoration: none;\">\r\n                        <img src=\"/img/LOGO.png\" alt=\"AL HARMAIN UMRAH TRANSPORT Logo\"\r\n                            style=\"height: 60px; width: auto; max-height: 60px; object-fit: contain; display: inline-block; vertical-align: middle; \" loading=\"lazy\" decoding=\"async\">\r\n                        <span\r\n                            style=\"font-weight: 700; color: var(--clr-accent); font-size: var(--text-xl); letter-spacing: 0.5px; font-family: 'Poppins', sans-serif;\">Al\r\n                            Armain Umrah Transport</span>\r\n                    </a>\r\n                    <p class=\"footer-text\">\r\n                        Get reliable Sedan cars, SUVs, luxury cars, coasters and buses for your Hajj and Umrah journey.\r\n                        Travel in brand-new luxury vehicles with ultimate comfort.\r\n                    </p>\r\n                </div>\r\n                <!-- Quick Links Menu Column -->\r\n                <div class=\"col-lg-2 col-md-6\">\r\n                    <h5 class=\"footer-heading\">Quick Links</h5>\r\n                    <ul class=\"footer-links\">\r\n                        <li><a href=\"/\">Home</a></li>\r\n                        <li><a href=\"/book-now\">Pricing & Booking</a></li>\r\n                        <li><a href=\"/fleet\">Our Fleet</a></li>\r\n                        <li><a href=\"/customer-faqs\">Customer FAQs</a></li>\r\n                        <li><a href=\"/contact\">Contact Us</a></li>\r\n                    <li><a href=\"/ziyarat-guide\">Ziyarat Guide</a></li></ul>\r\n                </div>\r\n                <!-- Company Links Menu Column -->\r\n                <div class=\"col-lg-2 col-md-6\">\r\n                    <h5 class=\"footer-heading\">Our Company</h5>\r\n                    <ul class=\"footer-links\">\r\n                        <li><a href=\"/who-we-are\">About Us</a></li>\r\n                        <li><a href=\"/privacy-policy\">Privacy Policy</a></li>\r\n                        <li><a href=\"/partner-terms\">Partner Terms</a></li>\r\n                    </ul>\r\n                </div>\r\n                <!-- Get in Touch Column -->\r\n                <div class=\"col-lg-3 col-md-6\">\r\n                    <h5 class=\"footer-heading\">Get in Touch</h5>\r\n                    <ul class=\"footer-links contact-info\" style=\"font-size: var(--text-sm);\">\r\n                        <li><i class=\"fas fa-phone-alt\"></i> Call: <a href=\"tel:+966596789290\">+966 59 678 9290</a></li>\r\n                        <li><i class=\"fab fa-whatsapp\"></i><a data-wa=\"general\" href=\"https://wa.me/966565476113?text=Assalamu%20Alaikum%2C%20I%20would%20like%20to%20ask%20about%20your%20Umrah%20transport%20services.%0APage%3A%20https%3A%2F%2Falhar